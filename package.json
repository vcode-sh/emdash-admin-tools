{
	"name": "emdash-admin-tools",
	"version": "0.1.0",
	"description": "Modular administrator tools for EmDash, starting with Empty Trash.",
	"license": "MIT",
	"author": "Vibe Code (https://vcode.sh)",
	"repository": {
		"type": "git",
		"url": "https://github.com/vcode-sh/emdash-admin-tools.git"
	},
	"type": "module",
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./admin": "./src/admin/index.tsx"
	},
	"files": [
		"dist",
		"src/admin",
		"src/modules",
		"docs",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts --clean",
		"check": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "bun test tests",
		"dev:fixture": "node scripts/fixture.mjs"
	},
	"peerDependencies": {
		"emdash": "1.3.0",
		"react": "^19.3.1"
	},
	"devDependencies": {
		"@astrojs/node": "11.1.8",
		"@astrojs/react": "7.1.0",
		"@biomejs/biome": "2.5.15",
		"@types/bun": "1.4.3",
		"@types/react": "19.3.0",
		"astro": "7.4.0",
		"emdash": "1.3.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tsdown": "0.23.1",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.4.3",
	"engines": {
		"node": ">=24.18.0"
	},
	"keywords": [
		"emdash",
		"emdash-plugin",
		"admin-tools",
		"trash"
	]
}
